<Window x:Class="商业超体价值与定位.Views.BlueprintExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="商业蓝图 - 预览与导出"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#16213E" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="🎯 终极商业蓝图"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="基于AI深度诊断生成的精准商业定位方案"
                           FontSize="14"
                           Foreground="#A0A0A0"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- 内容预览 -->
        <Border Grid.Row="1" Background="#16213E" CornerRadius="12" Padding="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：结构化内容 -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 超级签名 -->
                        <Border Background="#252A40" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="一句话超级签名"
                                           FontSize="14"
                                           Foreground="#E94560"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>
                                <TextBlock x:Name="SuperSignatureText"
                                           FontSize="18"
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           FontWeight="Bold"
                                           LineHeight="28"/>
                            </StackPanel>
                        </Border>

                        <!-- 信任构建SOP -->
                        <Border Background="#252A40" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="信任构建SOP"
                                           FontSize="14"
                                           Foreground="#FF9800"
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>

                                <TextBlock Text="成功案例"
                                           x:Name="CaseStudiesLabel"
                                           Foreground="#A0A0A0"
                                           FontSize="12"
                                           Margin="0,0,0,5"/>
                                <ItemsControl x:Name="CaseStudiesControl" Margin="0,0,0,15">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A1A2E" CornerRadius="4" Padding="10,5" Margin="0,2">
                                                <TextBlock Text="{Binding}" Foreground="White" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="资质背书"
                                           x:Name="QualificationsLabel"
                                           Foreground="#A0A0A0"
                                           FontSize="12"
                                           Margin="0,0,0,5"/>
                                <ItemsControl x:Name="QualificationsControl" Margin="0,0,0,15">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A1A2E" CornerRadius="4" Padding="10,5" Margin="0,2">
                                                <TextBlock Text="{Binding}" Foreground="White" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="社交证明"
                                           x:Name="SocialProofsLabel"
                                           Foreground="#A0A0A0"
                                           FontSize="12"
                                           Margin="0,0,0,5"/>
                                <ItemsControl x:Name="SocialProofsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A1A2E" CornerRadius="4" Padding="10,5" Margin="0,2">
                                                <TextBlock Text="{Binding}" Foreground="White" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 空白状态提示：三项均无内容时显示 -->
                                <Border x:Name="TrustSopEmptyHint"
                                        Background="#3A2A2A"
                                        BorderBrush="#E94560"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="15,12"
                                        Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="⚠️ 信任构建 SOP 暂未提取到内容"
                                                   Foreground="#FF9800"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="#D0D0D0"
                                                   FontSize="12"
                                                   LineHeight="20">
                                            <Run Text="可能原因：AI 在最终蓝图中省略了「信任构建SOP」章节。"/>
                                            <LineBreak/>
                                            <Run Text="建议您："/>
                                            <LineBreak/>
                                            <Run Text="  1. 在右侧「完整蓝图内容」中手动补充案例/资质/见证"/>
                                            <LineBreak/>
                                            <Run Text="  2. 或回到对话中明确告知 AI 您的真实客户案例与资质"/>
                                            <LineBreak/>
                                            <Run Text="  3. 或在导出 PDF 后，使用文档工具补充此章节"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 交付模式 -->
                        <Border Background="#252A40" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="交付模式建议"
                                           FontSize="14"
                                           Foreground="#4CAF50"
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="模式名称"
                                                   Foreground="#A0A0A0"
                                                   FontSize="12"/>
                                        <TextBlock x:Name="DeliveryModeName"
                                                   FontSize="16"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="服务类型"
                                                   Foreground="#A0A0A0"
                                                   FontSize="12"/>
                                        <TextBlock x:Name="DeliveryModeType"
                                                   FontSize="16"
                                                   Foreground="#4CAF50"
                                                   FontWeight="Bold"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 分隔线 -->
                <Border Grid.Column="1" Background="#3A3F5C" Width="1"/>

                <!-- 右侧：完整内容 -->
                <Border Grid.Column="2" Background="#252A40" CornerRadius="8" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="完整蓝图内容"
                                   FontSize="14"
                                   Foreground="#2196F3"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="FullContentText"
                                       Foreground="#E0E0E0"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       LineHeight="24"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="关闭"
                    Click="CloseButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="100"
                    Margin="0,0,10,0"/>
            <Button Content="📄 导出 MD"
                    Click="ExportMdButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="130"
                    Margin="0,0,10,0"/>
            <Button Content="💾 导出 PDF"
                    Click="ExportButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="150"/>
        </StackPanel>
    </Grid>
</Window>
