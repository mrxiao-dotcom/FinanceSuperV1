<UserControl x:Class="商业超体价值与定位.Views.BusinessCanvasPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:商业超体价值与定位.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BusinessCanvasViewModel}"
             Background="#1A1A2E">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- 顶部标题栏 -->
            <Border Background="#16213E" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="📊"
                                       FontSize="24"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="动态商业画布"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="实时商业诊断可视化"
                                           FontSize="12"
                                           Foreground="#A0A0A0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="完成度："
                                       Foreground="#A0A0A0"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding CompletionPercentage, StringFormat='{}{0:P0}'}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#4CAF50"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- 进度详情 -->
                    <Border Grid.Row="1" Background="#252A40" CornerRadius="8" Padding="15" Margin="0,15,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="🔍 诊断进度：" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding DiagnosticProgress}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#E94560"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <ProgressBar Grid.Column="1"
                                        Value="{Binding CompletionPercentage}"
                                        Minimum="0" Maximum="1"
                                        Height="12"
                                        Margin="20,0"
                                        VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding DiagnosticProgressDetail}"
                                       Foreground="#808080"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       MaxWidth="200"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- 下一步行动指引 -->
                    <Border Grid.Row="2"
                            Background="#1F2A40"
                            CornerRadius="8"
                            Padding="15,12"
                            Margin="0,12,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CompletionPercentage}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding NextStepGuidance}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 6 项诊断进度清单（来自 AI 自述） -->
                    <Border Grid.Row="3"
                            Background="#252A40"
                            CornerRadius="8"
                            Padding="15,10"
                            Margin="0,12,0,0"
                            Visibility="{Binding ProgressChecklist.Count, Converter={StaticResource CountToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="📋 诊断清单"
                                       Foreground="#A0A0A0"
                                       FontSize="11"
                                       Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding ProgressChecklist}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       FontSize="13"
                                                       Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="⏳"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Text" Value="✅"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           Foreground="White"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="10"
                                                           Foreground="#808080"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding Description, Converter={StaticResource StringToVisConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 护城河卡片 -->
            <Border CornerRadius="12" Padding="20" Margin="0,0,0,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#252A40"/>
                        <Setter Property="BorderBrush" Value="#3A3F5C"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MoatCard.IsActivated}" Value="True">
                                <Setter Property="BorderBrush" Value="#E94560"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#E94560" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="🏰 护城河" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="独占资源与认知资产" FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="10" Padding="8,4" VerticalAlignment="Center" Background="#3A3F5C">
                            <TextBlock FontSize="11" Foreground="White">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="等待中..."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MoatCard.IsActivated}" Value="True">
                                                <Setter Property="Text" Value="✓ 已激活"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding MoatCard.Content}" Foreground="#D0D0D0" TextWrapping="Wrap" Margin="0,15,0,10" FontSize="14" LineHeight="22"/>
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding MoatCard.ExclusiveResources}" Visibility="{Binding MoatCard.IsActivated, Converter={StaticResource BoolToVisConverter}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E94560" CornerRadius="4" Padding="8,4" Margin="0,0,5,5">
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 客户痛点卡片 -->
            <Border CornerRadius="12" Padding="20" Margin="0,0,0,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#252A40"/>
                        <Setter Property="BorderBrush" Value="#3A3F5C"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PainPointCard.IsActivated}" Value="True">
                                <Setter Property="BorderBrush" Value="#FF9800"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF9800" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="⚡ 客户痛点" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="隐性成本与致命风险" FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="10" Padding="8,4" VerticalAlignment="Center" Background="#3A3F5C">
                            <TextBlock FontSize="11" Foreground="White">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="等待中..."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PainPointCard.IsActivated}" Value="True">
                                                <Setter Property="Text" Value="✓ 已激活"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding PainPointCard.Content}" Foreground="#D0D0D0" TextWrapping="Wrap" Margin="0,15,0,10" FontSize="14" LineHeight="22"/>
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding PainPointCard.HiddenCosts}" Visibility="{Binding PainPointCard.IsActivated, Converter={StaticResource BoolToVisConverter}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF9800" CornerRadius="4" Padding="8,4" Margin="0,0,5,5">
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 情感溢价卡片 -->
            <Border CornerRadius="12" Padding="20" Margin="0,0,0,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#252A40"/>
                        <Setter Property="BorderBrush" Value="#3A3F5C"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EmotionalPremiumCard.IsActivated}" Value="True">
                                <Setter Property="BorderBrush" Value="#9C27B0"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#9C27B0" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="💎 情感溢价" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="驱动定价的情感因素" FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="10" Padding="8,4" VerticalAlignment="Center" Background="#3A3F5C">
                            <TextBlock FontSize="11" Foreground="White">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="等待中..."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EmotionalPremiumCard.IsActivated}" Value="True">
                                                <Setter Property="Text" Value="✓ 已激活"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding EmotionalPremiumCard.Content}" Foreground="#D0D0D0" TextWrapping="Wrap" Margin="0,15,0,10" FontSize="14" LineHeight="22"/>
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding EmotionalPremiumCard.EmotionalDrivers}" Visibility="{Binding EmotionalPremiumCard.IsActivated, Converter={StaticResource BoolToVisConverter}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#9C27B0" CornerRadius="4" Padding="8,4" Margin="0,0,5,5">
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 商业蓝图卡片 -->
            <Border CornerRadius="12" Padding="20" Margin="0,0,0,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#252A40"/>
                        <Setter Property="BorderBrush" Value="#3A3F5C"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BlueprintCard.IsActivated}" Value="True">
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#2196F3" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="🎯 商业蓝图" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="终极定位与交付模式" FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="10" Padding="8,4" VerticalAlignment="Center" Background="#3A3F5C">
                            <TextBlock FontSize="11" Foreground="White">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="等待中..."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BlueprintCard.IsActivated}" Value="True">
                                                <Setter Property="Text" Value="✓ 已激活"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding BlueprintCard.Content}" Foreground="#D0D0D0" TextWrapping="Wrap" Margin="0,15,0,0" FontSize="14" LineHeight="22"/>
                </Grid>
            </Border>

            <!-- 竞品分析区域 -->
            <Border Background="#16213E"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,15"
                    Visibility="{Binding ShowCompetitiveAnalysis, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <TextBlock Text="🔍 竞品分析" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                    <TextBlock Text="竞争对手盲区" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,5"/>
                    <ItemsControl ItemsSource="{Binding CompetitiveAnalysis.CompetitorBlindSpots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252A40" CornerRadius="4" Padding="10,5" Margin="0,2">
                                    <TextBlock Text="{Binding}" Foreground="White" FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="我们独占优势" Foreground="#A0A0A0" FontSize="12" Margin="0,15,0,5"/>
                    <ItemsControl ItemsSource="{Binding CompetitiveAnalysis.OurExclusiveAdvantages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F3460" CornerRadius="4" Padding="10,5" Margin="0,2">
                                    <TextBlock Text="{Binding}" Foreground="#4CAF50" FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,20">
                <Button Content="🔄 手动提炼"
                        Command="{Binding ManualExtractCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        ToolTip="根据当前所有对话内容重新提炼关键信息"/>

                <Button Content="💾 保存会话"
                        Command="{Binding SaveSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"/>

                <Button Content="👁️ 查看商业蓝图"
                        Command="{Binding GenerateBlueprintCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding CanGenerateBlueprint}"
                        Margin="0,0,10,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ProgressBar IsIndeterminate="True"
                                 Width="100"
                                 Height="16"
                                 Visibility="{Binding IsGeneratingBlueprint, Converter={StaticResource BoolToVisConverter}}"
                                 Foreground="#4CAF50"/>
                    <TextBlock Text="{Binding BlueprintStatus}"
                               Foreground="#A0A0A0"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <Button Content="💾 导出PDF"
                        Command="{Binding ExportToPdfCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanGenerateBlueprint}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
