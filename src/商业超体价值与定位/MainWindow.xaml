<Window x:Class="商业超体价值与定位.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:商业超体价值与定位.ViewModels"
        xmlns:views="clr-namespace:商业超体价值与定位.Views"
        mc:Ignorable="d"
        Title="商业超体：价值与定位"
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部菜单 -->
        <Menu DockPanel.Dock="Top" Background="#16213E" Foreground="White" Padding="10,5">
            <MenuItem Header="文件" Foreground="White">
                <MenuItem Header="新会话" Command="{Binding StartNewSessionCommand}"/>
                <MenuItem Header="历史会话" Command="{Binding ToggleHistoryPanelCommand}"/>
                <Separator/>
                <MenuItem Header="导出商业蓝图..." Click="ExportBlueprint_Click"/>
                <Separator/>
                <MenuItem Header="退出" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="设置" Foreground="White">
                <MenuItem Header="LLM API 配置..." Click="OpenSettings_Click"/>
            </MenuItem>
            <MenuItem Header="帮助" Foreground="White">
                <MenuItem Header="关于商业超体" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- 主内容区 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：历史会话列表 + AI战略顾问对话舱 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 历史会话列表 -->
                <Border Grid.Row="0"
                        Background="#16213E"
                        Padding="10"
                        Visibility="{Binding IsHistoryPanelVisible, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <!-- 标题栏 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="▼"
                                    ToolTip="收起历史会话"
                                    Command="{Binding ToggleHistoryPanelCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#808080"
                                    FontSize="12"
                                    Padding="5,2"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"/>

                            <TextBlock Grid.Column="1"
                                       Text="历史会话"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="2"
                                    Content="🗑️"
                                    ToolTip="删除当前选中会话"
                                    Command="{Binding SessionListViewModel.DeleteSessionCommand}"
                                    CommandParameter="{Binding SessionListViewModel.SelectedSession}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#808080"
                                    FontSize="14"
                                    Padding="5,2"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <ListBox ItemsSource="{Binding SessionListViewModel.Sessions}"
                                 SelectedItem="{Binding SessionListViewModel.SelectedSession}"
                                 Background="#252A40"
                                 BorderThickness="0"
                                 MaxHeight="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6"
                                            Margin="0,2"
                                            Background="#2A3040"
                                            CornerRadius="4"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SessionListViewModel.SwitchToSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="White"
                                                           FontSize="12"/>
                                                <TextBlock Foreground="#808080"
                                                           FontSize="10">
                                                    <Run Text="{Binding MessageCount, StringFormat={}{0} 条消息}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding LastModifiedAt, StringFormat={}{0:MM-dd HH:mm}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="#E94560"
                                                    CornerRadius="3"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsCurrentSession, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}">
                                                <TextBlock Text="当前"
                                                           Foreground="White"
                                                           FontSize="10"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="点击会话名称切换，选中后点击垃圾桶删除"
                                   Foreground="#606060"
                                   FontSize="10"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- AI战略顾问对话舱 -->
                <views:ChatPanel Grid.Row="1"
                                 DataContext="{Binding ChatViewModel}"/>
            </Grid>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          Background="#16213E"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"/>

            <!-- 右侧：动态商业画布监控区 -->
            <views:BusinessCanvasPanel Grid.Column="2"
                                      DataContext="{Binding BusinessCanvasViewModel}"/>
        </Grid>
    </DockPanel>
</Window>
